# Anthropic Claude API (요약용)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API (분류용, 2026-08-08부터)
OPENAI_API_KEY=sk-...

# Telegram
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHANNEL_ID=-100...
TELEGRAM_ADMIN_USER_ID=...


# jarchive 논평 검색 (1순위 — 뜻 검색으로 정확도 높음)
JARCHIVE_API_URL=https://jarchive-swart.vercel.app

# jpnews 중앙당 논평 시트 (2순위 대체 — jarchive 접속 안 될 때)
JPNEWS_SHEETS_CREDENTIALS=...  # base64 인코딩된 서비스 계정 JSON (jpnews와 동일)
JPNEWS_SHEET_ID=...            # jpnews 구글시트 ID
# 기타
LOG_LEVEL=INFO
TIMEZONE=Asia/Seoul
